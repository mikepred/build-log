{
  "config_version": 1,
  "status": "draft_requires_runner",
  "enabled": false,
  "mode": "review_only",
  "events": ["opened", "synchronize", "ready_for_review", "reopened"],
  "skip_drafts": true,
  "rotation": {
    "strategy": "round_robin",
    "scope": "pull_request",
    "advance_on": "new_head_sha",
    "initial_index": 0,
    "state_backend": "runner_required",
    "deduplicate_by": ["pull_request_number", "head_sha"],
    "agents": [
      {"id": "perplexity", "provider": "perplexity", "enabled": false, "model": null, "api_key_secret": "PERPLEXITY_API_KEY", "activation_requires": ["runner_implementation", "model_selection", "repository_secret", "budget_approval"]}
    ],
    "additional_agents": "Add explicitly approved provider entries before enabling rotation. With one enabled entry there is no multi-agent rotation."
  },
  "existing_reviewers": {
    "claude": {"workflow": ".github/workflows/claude-code-review.yml", "management": "unchanged_external_to_rotation"},
    "others": "Existing reviewer integrations remain unchanged; none are implicitly added to this rotation."
  },
  "output": {
    "type": "pull_request_comment",
    "update_existing_agent_comment": true,
    "include_reviewed_head_sha": true,
    "discard_if_head_changed": true,
    "focus": ["correctness", "security", "regressions", "missing_tests"],
    "max_findings": 5,
    "require_file_and_line_evidence": true,
    "approve": false,
    "request_changes": false
  },
  "safety": {
    "auto_merge": false,
    "modify_repository_files": false,
    "execute_pull_request_code": false,
    "expose_secrets_to_pull_request_code": false,
    "fork_pull_requests": "skip",
    "treat_pr_content_as_untrusted_data": true,
    "provider_receives": "Filtered PR metadata and diff only; enabling requires acceptance of external processing.",
    "exclude_paths": ["**/.env*", "**/*.pem", "**/*.key", "**/credentials*", "package-lock.json"],
    "max_diff_bytes": 60000,
    "oversized_diff": "skip_with_notice",
    "max_provider_calls_per_revision": 1,
    "timeout_seconds": 120,
    "failure_policy": "non_blocking"
  },
  "integrations": {"linear": false, "notion": false, "context7": false},
  "notes": ["Declarative project policy, not a standard GitHub configuration format.", "No workflow consumes this file yet; creating it does not deploy an agent.", "Chat MCP credentials are not inherited by GitHub Actions."]
}
