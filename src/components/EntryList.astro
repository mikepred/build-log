---
import type { CollectionEntry } from 'astro:content';
import { entryHref, formatDate, isoDate, tagHref } from '../lib/entries';

interface Props {
  entries: CollectionEntry<'entries'>[];
}

const { entries } = Astro.props;
---

{
  entries.length === 0 ? (
    <p class="empty">No entries yet.</p>
  ) : (
    <div class="entries">
      {entries.map((entry) => (
        <article class="entry-summary">
          <p class="meta">
            <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
          </p>
          <h2>
            <a href={entryHref(entry.id)}>{entry.data.title}</a>
          </h2>
          <p class="summary">{entry.data.summary}</p>
          {entry.data.tags.length > 0 && (
            <ul class="tags">
              {entry.data.tags.map((tag) => (
                <li>
                  <a href={tagHref(tag)}>{tag}</a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  )
}
