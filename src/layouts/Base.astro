---
import '../styles/global.css';
import { contentLicenseUrl, mitLicenseUrl, siteTitle } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  home?: boolean;
}

const { title, description, canonical, home = false } = Astro.props;

if (!Astro.site) {
  throw new Error('site must be set in astro.config.');
}

const rssUrl = new URL('rss.xml', new URL(import.meta.env.BASE_URL, Astro.site));
const pageTitle = home ? siteTitle : `${title} · ${siteTitle}`;
const homeHref = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={rssUrl.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <header>
        {
          home ? (
            <h1 class="site-name">
              <a href={homeHref}>{siteTitle}</a>
            </h1>
          ) : (
            <p class="site-name">
              <a href={homeHref}>{siteTitle}</a>
            </p>
          )
        }
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Code and snippets <a href={mitLicenseUrl} rel="license">MIT</a>. Posts <a
            href={contentLicenseUrl}
            rel="license">CC BY 4.0</a
          >.
        </p>
        <p><a href={rssUrl.href}>RSS</a></p>
      </footer>
    </div>
  </body>
</html>
