---
import '../styles/global.css';
import {
  authorName,
  authorUrl,
  authorUsername,
  contentLicenseUrl,
  mitLicenseUrl,
  ogImageAlt,
  ogImageHeight,
  ogImagePath,
  ogImageWidth,
  siteTitle,
} from '../lib/site';
import { isoDate } from '../lib/entries';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  home?: boolean;
  /** Set on post pages: switches og:type to article and adds BlogPosting JSON-LD. */
  article?: {
    date: Date;
    tags: string[];
  };
  /** Pages with no stable URL of their own (404) skip canonical and og:url. */
  noindex?: boolean;
}

const { title, description, canonical, home = false, article, noindex = false } = Astro.props;

if (!Astro.site) {
  throw new Error('site must be set in astro.config.');
}

const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site);
const rssUrl = new URL('rss.xml', siteRoot);
const pageTitle = home ? siteTitle : `${title} · ${siteTitle}`;
const socialTitle = home ? siteTitle : title;
// Posts pass their canonical_url. Every other page is canonical at its own Pages URL.
const pageUrl = noindex ? undefined : (canonical ?? new URL(Astro.url.pathname, Astro.site).href);
const ogImage = new URL(ogImagePath, siteRoot).href;
const jsonLd = article
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: isoDate(article.date),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      image: ogImage,
      keywords: article.tags,
      inLanguage: 'en',
      author: {
        '@type': 'Person',
        name: authorName,
        alternateName: authorUsername,
        url: authorUrl,
      },
      publisher: {
        '@type': 'Person',
        name: authorName,
        alternateName: authorUsername,
        url: authorUrl,
      },
    }).replace(/</g, '\\u003c')
  : undefined;
const homeHref = import.meta.env.BASE_URL;
const logHref = `${import.meta.env.BASE_URL}log/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {article && <meta property="article:published_time" content={isoDate(article.date)} />}
    {article && <meta property="article:author" content={authorUrl} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="author" content={`${authorName} (${authorUsername})`} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={rssUrl.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <div class="shell">
      <header>
        {
          home ? (
            <h1 class="site-name">
              <a href={homeHref}>{siteTitle}</a>
            </h1>
          ) : (
            <p class="site-name">
              <a href={homeHref}>{siteTitle}</a>
            </p>
          )
        }
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Code and snippets <a href={mitLicenseUrl} rel="license">MIT</a>. Posts <a
            href={contentLicenseUrl}
            rel="license">CC BY 4.0</a
          >.
        </p>
        <p><a href={logHref}>Log</a> · <a href={rssUrl.href}>RSS</a></p>
      </footer>
    </div>
  </body>
</html>
